{
  "expo": {
    "name": "BascyBros",
    "slug": "bascybrosmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main.png",
    "scheme": "bascybrosmobile",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.bascybros.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow BascyBros to take photos of your notes, screenshots, and CTF challenges.",
        "NSPhotoLibraryUsageDescription": "Allow BascyBros to attach images from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Allow BascyBros to save images to your photo library."
      }
    },
    "android": {
      "package": "xyz.bascybros.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/main.png",
        "monochromeImage": "./assets/images/main.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/main.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "disableAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BascyBros to attach images from your photo library.",
          "cameraPermission": "Allow BascyBros to take photos of your notes, screenshots, and CTF challenges."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/main.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/with-android-share-task-root.js",
      "./plugins/with-android-share-receiver.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8839bb94-a465-4a11-991d-99745b3d1fec"
      }
    },
    "owner": "basinasgeorgeee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8839bb94-a465-4a11-991d-99745b3d1fec",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
