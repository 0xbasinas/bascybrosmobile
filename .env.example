# Base URL of the BascyBros Next.js backend (no trailing slash).
# Use the dev server's LAN IP for physical-device testing, e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Same Clerk publishable key as the web app's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
# Required, non-secret (safe to expose in the bundle).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
